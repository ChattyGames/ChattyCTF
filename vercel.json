{
  "buildCommand": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "framework": null,
  "functions": {
    "api/board.js": {
      "includeFiles": "server/answers.json",
      "maxDuration": 30
    }
  }
}
